# ==============================================================================
# Wav2Vec2 Persian STT - Environment configuration template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is ignored by git (see .gitignore) and must NEVER be committed.
#
# How configuration is resolved (highest priority first):
#   1. Real environment variables exported in your shell
#   2. Values defined in your local `.env` file
#   3. Safe generic defaults from `config/config.yaml`
#
# Every variable below is optional unless marked REQUIRED. Unset or empty
# variables fall back to `config/config.yaml` defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets
# ------------------------------------------------------------------------------

# Hugging Face access token (REQUIRED only for private/gated base models).
# Create one at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# ------------------------------------------------------------------------------
# Base model & dataset locations
# ------------------------------------------------------------------------------

# Hugging Face model id of the base checkpoint used for fine-tuning
#WAV2VEC2_MODEL_NAME=jonatasgrosman/wav2vec2-large-xlsr-53-persian

# Directory containing the training audio files (.wav/.mp3/.flac)
#WAV2VEC2_AUDIO_FILES_DIR=dataset/audio_files

# Directory containing the transcript JSON files
#WAV2VEC2_JSON_INFO_DIR=dataset/info

# Directory containing the held-out test audio (plus optional test.json)
#WAV2VEC2_TEST_AUDIO_DIR=dataset/test_audio

# Fraction of the dataset used for training (remainder is validation)
#WAV2VEC2_TRAIN_VAL_SPLIT=0.8

# ------------------------------------------------------------------------------
# Training matrix (tuned hyperparameters)
# ------------------------------------------------------------------------------

#WAV2VEC2_BATCH_SIZE=2
#WAV2VEC2_NUM_EPOCHS=3
#WAV2VEC2_LEARNING_RATE=1e-4
#WAV2VEC2_WEIGHT_DECAY=0.01
#WAV2VEC2_WARMUP_STEPS=0
#WAV2VEC2_GRADIENT_ACCUMULATION_STEPS=1
#WAV2VEC2_MAX_AUDIO_LENGTH=30.0        # seconds; `none` for no limit
#WAV2VEC2_NUM_WORKERS=2

# Learning-rate scheduling (ReduceLROnPlateau on validation WER)
#WAV2VEC2_USE_REDUCE_LR_ON_PLATEAU=false
#WAV2VEC2_REDUCE_LR_PATIENCE=2
#WAV2VEC2_REDUCE_LR_FACTOR=0.5
#WAV2VEC2_REDUCE_LR_MIN=1e-6

# Early stopping (`none` disables)
#WAV2VEC2_EARLY_STOPPING_PATIENCE=5
#WAV2VEC2_EARLY_STOPPING_MIN_DELTA=0.001

# Gradient clipping and reproducibility
#WAV2VEC2_GRADIENT_CLIP_NORM=1.0
#WAV2VEC2_RANDOM_SEED=42

# ------------------------------------------------------------------------------
# Inference behaviour
# ------------------------------------------------------------------------------

# Chunk length (seconds) used when transcribing long audio
#WAV2VEC2_CHUNK_DURATION=30
#WAV2VEC2_SKIP_SHORT_CHUNKS=true
#WAV2VEC2_MIN_CHUNK_SAMPLES=1000
#WAV2VEC2_BLANK_TOKEN_THRESHOLD=0.95

# ------------------------------------------------------------------------------
# Output & logging
# ------------------------------------------------------------------------------

#WAV2VEC2_OUTPUT_DIR=outputs
#WAV2VEC2_SAVE_EVERY_N_EPOCHS=1
#WAV2VEC2_LOG_FILE=outputs/training.log   # `none` for console-only logging
#WAV2VEC2_LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ------------------------------------------------------------------------------
# Device / runtime toggles
# ------------------------------------------------------------------------------

#WAV2VEC2_USE_CUDA=true
#WAV2VEC2_MIXED_PRECISION=true
#WAV2VEC2_EMPTY_CACHE_AFTER_VAL=true

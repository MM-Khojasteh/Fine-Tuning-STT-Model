# ==============================================================================
# Wav2Vec2 Persian STT - Strict ignore policy (allowlist / least privilege)
#
# Strategy: EVERYTHING is ignored by default. Only the paths re-included in
# the ALLOWLIST section below can ever be tracked. Any new file (data dumps,
# model weights, scratch scripts, IDE state) therefore stays local
# automatically - it must be deliberately allowlisted to enter the repository.
#
# To track a new file, add an explicit `!` rule to the ALLOWLIST section.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECRETS - ignored unconditionally, first and foremost
# ------------------------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.*
*.token

# ------------------------------------------------------------------------------
# 2. ALLOWLIST - the ONLY paths permitted in the repository
# ------------------------------------------------------------------------------
/*
!/.gitignore
!/.env.example
!/README.md
!/LICENSE
!/requirements.txt
!/install_pytorch_cuda.ps1
!/train.py
!/evaluate.py
!/inference.py
!/test_predictions.py
!/src/
!/src/**
!/config/
!/config/config.yaml

# ------------------------------------------------------------------------------
# 3. DEFENSE IN DEPTH - explicitly blocked regardless of any rule above
# ------------------------------------------------------------------------------

# Virtual environments
.venv/
venv/
env/
.conda/

# Python bytecode, packaging and test caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.tox/
.nox/
.coverage
htmlcov/
.ipynb_checkpoints/

# Model weights and serialized artifacts (any framework)
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx
*.h5
*.hdf5
*.pb
*.tflite
*.pkl
*.pickle
*.msgpack
*.ot

# Data: audio, transcripts, database exports, results - NEVER publish
dataset/
datasets/
data/
outputs/
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.sqlite
*.db
*.sql
*.duckdb

# Experiment tracking
logs/
runs/
wandb/
mlruns/
tensorboard_logs/

# Local working notes / internal docs (never published)
notes/

# IDE, editor, OS and AI-assistant local state
.idea/
.vscode/
*.swp
*.swo
*~
.claude/
.cursor/
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 4. FINAL WORD - secrets restated last so they stay ignored no matter what
#    is ever added to the allowlist above (gitignore: last match wins)
# ------------------------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.*
*.token
